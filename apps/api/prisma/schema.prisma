// Persistência do InfraFlow (PRD §49, §71).
//
// O grafo é gravado como documento JSONB numa versão, não como tabelas de nodes
// e edges. O §33 define o architecture.json como fonte estruturada com
// prioridade sobre o resto, e o §38/§80 pedem versões clonáveis e comparáveis:
// um documento validado por versão dá atomicidade no autosave e torna clone e
// comparação triviais. Nenhum requisito do produto consulta um node isolado.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Dono das arquiteturas. O protótipo simulava autenticação (PRD §7); a partir
/// daqui ela é real, porque persistência sem dono não tem como isolar dados.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  /// scrypt: `N$r$p$salt$hash`, tudo em hex. Nunca a senha em claro.
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects Project[]
  sessions Session[]

  @@map("users")
}

/// Sessão opaca em cookie httpOnly. Só o hash do token vai para o banco, então
/// vazamento de dump não dá acesso a sessão viva.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Project {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  slug      String   @unique
  name      String
  /// Preferências do projeto (PRD §71 — settings).
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  architectures Architecture[]

  @@index([ownerId])
  @@map("projects")
}

model Architecture {
  id          String @id @default(uuid()) @db.Uuid
  projectId   String @db.Uuid
  name        String
  /// PRD §9 — provider e environment do canvas.
  provider    String
  environment String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions ArchitectureVersion[]

  @@unique([projectId, name])
  @@map("architectures")
}

/// PRD §38 — cada mudança relevante vira uma versão.
model ArchitectureVersion {
  id             String @id @default(uuid()) @db.Uuid
  architectureId String @db.Uuid
  /// Sequencial por arquitetura: v1, v2, v3.
  number         Int
  /// Documento do canvas validado por @infraflow/schema.
  graph          Json
  label          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  architecture Architecture @relation(fields: [architectureId], references: [id], onDelete: Cascade)

  @@unique([architectureId, number])
  @@index([architectureId, createdAt])
  @@map("architecture_versions")
}
