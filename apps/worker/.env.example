DATABASE_URL=postgresql://infraflow:infraflow@localhost:5434/infraflow
REDIS_URL=redis://localhost:6381
# Raiz dos diretórios de execução. Cada run recebe o seu (PRD §52, §53).
INFRAFLOW_RUNS_ROOT=./var/runs
# Cache de providers do OpenTofu, compartilhado entre execuções.
TF_PLUGIN_CACHE_DIR=./var/tofu-plugins
