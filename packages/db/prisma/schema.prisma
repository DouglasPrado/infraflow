// Persistência do InfraFlow (PRD §49, §71).
//
// O grafo é gravado como documento JSONB numa versão, não como tabelas de nodes
// e edges. O §33 define o architecture.json como fonte estruturada com
// prioridade sobre o resto, e o §38/§80 pedem versões clonáveis e comparáveis:
// um documento validado por versão dá atomicidade no autosave e torna clone e
// comparação triviais. Nenhum requisito do produto consulta um node isolado.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Dono das arquiteturas. O protótipo simulava autenticação (PRD §7); a partir
/// daqui ela é real, porque persistência sem dono não tem como isolar dados.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  /// scrypt: `N$r$p$salt$hash`, tudo em hex. Nunca a senha em claro.
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects Project[]
  sessions Session[]

  @@map("users")
}

/// Sessão opaca em cookie httpOnly. Só o hash do token vai para o banco, então
/// vazamento de dump não dá acesso a sessão viva.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Project {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  slug      String   @unique
  name      String
  /// Preferências do projeto (PRD §71 — settings).
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  architectures Architecture[]

  @@index([ownerId])
  @@map("projects")
}

model Architecture {
  id          String @id @default(uuid()) @db.Uuid
  projectId   String @db.Uuid
  name        String
  /// PRD §9 — provider e environment do canvas.
  provider    String
  environment String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions ArchitectureVersion[]
  runs     Run[]
  labs     Lab[]

  @@unique([projectId, name])
  @@map("architectures")
}

/// PRD §38 — cada mudança relevante vira uma versão.
model ArchitectureVersion {
  id             String @id @default(uuid()) @db.Uuid
  architectureId String @db.Uuid
  /// Sequencial por arquitetura: v1, v2, v3.
  number         Int
  /// Documento do canvas validado por @infraflow/schema.
  graph          Json
  label          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  architecture Architecture @relation(fields: [architectureId], references: [id], onDelete: Cascade)
  runs         Run[]
  labs         Lab[]

  @@unique([architectureId, number])
  @@index([architectureId, createdAt])
  @@map("architecture_versions")
}

/// O que o worker executa fora da API (PRD §51).
enum RunKind {
  PLAN
  LAB_APPLY
  LAB_DESTROY
  LOAD_TEST

  @@map("run_kind")
}

/// Ciclo de vida do laboratório efêmero (PRD §76).
enum LabStatus {
  CREATING
  READY
  DESTROYING
  DESTROYED
  FAILED

  @@map("lab_status")
}

/// Infraestrutura temporária de um teste (PRD §53, §76).
///
/// Vive em rede própria, com nome próprio, e **só a porta de entrada é
/// publicada**. Guarda o diretório de trabalho porque o state do OpenTofu
/// precisa sobreviver entre o apply e o destroy — sem ele, `tofu destroy` não
/// teria o que destruir e o ambiente viraria órfão (§54).
model Lab {
  id             String    @id @default(uuid()) @db.Uuid
  architectureId String    @db.Uuid
  versionId      String    @db.Uuid
  /// Identificador do ambiente temporário (PRD §53).
  slug           String    @unique
  status         LabStatus @default(CREATING)
  /// Porta publicada em 127.0.0.1 — a única entrada do laboratório.
  entryPort      Int?
  entryUrl       String?
  /// Prometheus do laboratório, consultado pelo worker (PRD §36, §78).
  observabilityPort Int?
  observabilityUrl  String?
  /// Container por node do canvas: é o que liga métrica a recurso (§78).
  containers     Json      @default("[]")
  /// Diretório que guarda o state desta infraestrutura.
  workdir        String
  error          String?
  /// Depois disto o worker derruba o laboratório sozinho (§54).
  expiresAt      DateTime
  readyAt        DateTime?
  destroyedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  architecture Architecture        @relation(fields: [architectureId], references: [id], onDelete: Cascade)
  version      ArchitectureVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  runs         Run[]

  @@index([architectureId, createdAt])
  @@index([status, expiresAt])
  @@map("labs")
}

enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED

  @@map("run_status")
}

/// Uma execução de processo externo (PRD §51, §53).
///
/// Guarda o que o processo produziu, não o que se esperava dele: `result` é o
/// resumo estruturado, `logs` é a saída crua e `error` é o motivo da falha. Sem
/// isso o workspace não teria o que mostrar quando o `plan` não passa — e não
/// passar é informação, não ausência de resultado.
model Run {
  id             String    @id @default(uuid()) @db.Uuid
  architectureId String    @db.Uuid
  versionId      String    @db.Uuid
  kind           RunKind
  status         RunStatus @default(QUEUED)
  /// Identificador legível e único da execução (PRD §53).
  slug           String    @unique
  /// Entrada da execução: alvo da compilação, por exemplo.
  params         Json      @default("{}")
  /// Resumo estruturado do que aconteceu.
  result         Json?
  /// Saída combinada do processo externo, truncada.
  logs           String    @default("")
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  architecture Architecture        @relation(fields: [architectureId], references: [id], onDelete: Cascade)
  version      ArchitectureVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  labId        String?             @db.Uuid
  lab          Lab?                @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@index([architectureId, createdAt])
  @@index([status])
  @@map("runs")
}
